{
  "info": {
    "_postman_id": "bb0eb280-f1f2-4c4c-9cd6-62fa0d30cd35",
    "name": "Liga MX API - Spring Security JWT",
    "description": "Pruebas con JWT para ADMIN y VIEWER. Ejecuta primero el login del usuario correspondiente; el token se guarda automáticamente en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "teamId", "value": "1", "type": "string" },
    { "key": "playerId", "value": "1", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "admin123", "type": "string" },
    { "key": "viewerUsername", "value": "viewer", "type": "string" },
    { "key": "viewerPassword", "value": "viewer123", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "viewerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticacion JWT - Ejecutar primero",
      "item": [
        {
          "name": "Login ADMIN - Guardar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login ADMIN exitoso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"La respuesta contiene un token\", function () {",
                  "    pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", response.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Login VIEWER - Guardar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login VIEWER exitoso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"La respuesta contiene un token\", function () {",
                  "    pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"viewerToken\", response.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{viewerUsername}}\",\n  \"password\": \"{{viewerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "ADMIN - Todos los permisos",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{adminToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Teams",
          "item": [
            { "name": "Listar equipos - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams" }, "response": [] },
            { "name": "Obtener equipo por ID - 200/404", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}" }, "response": [] },
            {
              "name": "Crear equipo - 200",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tigres UANL\",\n  \"city\": \"San Nicolas de los Garza\",\n  \"stadium\": \"Estadio Universitario\",\n  \"foundingYear\": 1960\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/teams"
              },
              "response": []
            },
            {
              "name": "Actualizar equipo - 200/404",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tigres UANL Actualizado\",\n  \"city\": \"San Nicolas de los Garza\",\n  \"stadium\": \"Estadio Universitario\",\n  \"foundingYear\": 1960\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/teams/{{teamId}}"
              },
              "response": []
            },
            { "name": "Eliminar equipo - 200", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}" }, "response": [] }
          ]
        },
        {
          "name": "Players",
          "item": [
            { "name": "Listar jugadores - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/players" }, "response": [] },
            { "name": "Obtener jugador por ID - 200/404", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/players/{{playerId}}" }, "response": [] },
            { "name": "Listar jugadores por equipo - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}/players" }, "response": [] },
            {
              "name": "Crear jugador en equipo - 200/404",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Andre-Pierre Gignac\",\n  \"number\": 10,\n  \"position\": \"Delantero\",\n  \"nationality\": \"Francesa\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/teams/{{teamId}}/players"
              },
              "response": []
            },
            {
              "name": "Actualizar jugador - 200/404",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Andre-Pierre Gignac\",\n  \"number\": 10,\n  \"position\": \"Delantero centro\",\n  \"nationality\": \"Francesa\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/players/{{playerId}}"
              },
              "response": []
            },
            { "name": "Eliminar jugador - 204/404", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/players/{{playerId}}" }, "response": [] }
          ]
        }
      ]
    },
    {
      "name": "VIEWER - Permitido",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{viewerToken}}", "type": "string" }
        ]
      },
      "item": [
        { "name": "Listar equipos - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams" }, "response": [] },
        { "name": "Obtener equipo por ID - 200/404", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}" }, "response": [] },
        { "name": "Listar jugadores - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/players" }, "response": [] },
        { "name": "Obtener jugador por ID - 200/404", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/players/{{playerId}}" }, "response": [] },
        { "name": "Listar jugadores por equipo - 200", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}/players" }, "response": [] }
      ]
    },
