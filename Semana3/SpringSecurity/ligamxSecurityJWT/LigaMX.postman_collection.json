            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          },
          "response": []
        },
        { "name": "Eliminar equipo - 403 Forbidden", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/teams/{{teamId}}" }, "response": [] },
        {
          "name": "Crear jugador - 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
