            "url": "{{baseUrl}}/api/teams/{{teamId}}/players"
          },
          "response": []
        },
        {
          "name": "Actualizar jugador - 403 Forbidden",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jugador rechazado\",\n  \"number\": 10,\n  \"position\": \"Delantero\",\n  \"nationality\": \"Mexicana\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/players/{{playerId}}"
          },
          "response": []
        },
        { "name": "Eliminar jugador - 403 Forbidden", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/players/{{playerId}}" }, "response": [] }
      ]
    }
  ]
}
